"use client";

import { BarChart3, ChevronRight } from 'lucide-react';

export default function StrategyLabSidebarItem({ activeView, setActiveView }: any) {
  const isActive = activeView === 'tester';

  return (
    <button
      onClick={() => setActiveView('tester')}
      className={`w-full flex items-center gap-3 px-4 py-3 rounded-none transition-all duration-300 group ${isActive ? 'bg-indigo-500 text-white shadow-lg shadow-indigo-500/20' : 'text-slate-400 hover:text-white hover:bg-white/5'}`}
    >
      <div className={`p-2 rounded-none transition-colors ${isActive ? 'bg-white/20' : 'bg-white/5 group-hover:bg-white/10'}`}>
        <BarChart3 size={20} />
      </div>
      <span className="text-sm font-semibold tracking-wide">Strategy Lab</span>
      {isActive && <ChevronRight size={14} className="ml-auto text-white/50" />}
    </button>
  );
}
